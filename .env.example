# Copy this file to .env. Never commit .env or paste keys into chat/logs.

# Runtime
LEASH_ENV=development
LEASH_HOST=127.0.0.1
LEASH_PORT=8765
LEASH_LOG_LEVEL=INFO
LEASH_DATABASE_PATH=data/leash.sqlite3
LEASH_WORKSPACE_ROOT=demo/workspace

# Judge mode: recorded (safe local development), managed (Muse Wonder), unavailable
LEASH_JUDGE_MODE=recorded
LEASH_JUDGE_TIMEOUT_SECONDS=20
LEASH_APPROVAL_TTL_SECONDS=300
LEASH_REDACTION_KEY=replace-with-a-long-random-local-value

# Executor mode: mock for policy development, docker for the isolated demo profile
LEASH_EXECUTOR_MODE=mock
LEASH_EXECUTOR_IMAGE=python:3.12-slim-bookworm@sha256:e697c81897302a4c4333bade000d98038fbb21eb064f8ee1fd42d02ebcd9d337
LEASH_EXECUTOR_MEMORY_MB=256
LEASH_EXECUTOR_CPUS=1
LEASH_EXECUTOR_PIDS_LIMIT=64
LEASH_EXECUTOR_OUTPUT_BYTES=65536

# Meta Model API: Muse Spark actor + Muse Wonder judge
MODEL_API_KEY=
SPARK_BASE_URL=https://api.meta.ai/v1
SPARK_MODEL=muse-spark-1.3
JUDGE_BASE_URL=https://api.meta.ai/v1
JUDGE_MODEL=muse-wonder-1.0

# Comma-separated hostnames. Localhost is always permitted for safe demo receivers.
LEASH_ALLOWED_HTTP_HOSTS=localhost,127.0.0.1

