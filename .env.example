# Copy this file to .env. Never commit .env or paste keys into chat/logs.

# Runtime
LEASH_ENV=development
LEASH_HOST=127.0.0.1
LEASH_PORT=8765
LEASH_LOG_LEVEL=INFO
LEASH_DATABASE_PATH=data/leash.sqlite3
LEASH_WORKSPACE_ROOT=demo/workspace

# Actor stays recorded during local development to avoid consuming API credits.
LEASH_ACTOR_MODE=recorded
LEASH_AGENT_MAX_STEPS=8
LEASH_AGENT_TOKEN_BUDGET=32000
LEASH_AGENT_RECENT_RECEIPTS=4
LEASH_AGENT_RECEIPT_BYTES=4096
LEASH_INSPECTION_MAX_BYTES=32768
LEASH_INSPECTION_MAX_FILES=200
LEASH_INSPECTION_MAX_LINES=400
LEASH_INSPECTION_MAX_DEPTH=8
LEASH_PREVIEW_MAX_TARGETS=200
LEASH_PREVIEW_MAX_BYTES=10000000
LEASH_PREVIEW_MAX_DEPTH=8
LEASH_SPARK_REASONING_EFFORT=low
LEASH_SPARK_MAX_COMPLETION_TOKENS=4096
# Optional pricing inputs power cost estimates without hard-coding changing provider rates.
LEASH_SPARK_INPUT_COST_PER_MILLION_USD=
LEASH_SPARK_OUTPUT_COST_PER_MILLION_USD=

# Judge mode: recorded (safe local development), managed (Muse Wonder), unavailable
LEASH_JUDGE_MODE=recorded
LEASH_JUDGE_TIMEOUT_SECONDS=20
LEASH_JUDGE_MAX_CALLS_PER_SESSION=4
LEASH_JUDGE_PROMPT_VERSION=wonder-safety-v1
LEASH_POLICY_VERSION=demo-policy-v1
LEASH_WONDER_INPUT_COST_PER_MILLION_USD=
LEASH_WONDER_OUTPUT_COST_PER_MILLION_USD=
LEASH_APPROVAL_TTL_SECONDS=300
LEASH_REDACTION_KEY=replace-with-a-long-random-local-value

# Executor mode: mock for policy development, docker for the isolated demo profile
LEASH_EXECUTOR_MODE=mock
LEASH_EXECUTOR_IMAGE=python:3.12-slim-bookworm@sha256:e697c81897302a4c4333bade000d98038fbb21eb064f8ee1fd42d02ebcd9d337
LEASH_EXECUTOR_MEMORY_MB=256
LEASH_EXECUTOR_CPUS=1
LEASH_EXECUTOR_PIDS_LIMIT=64
LEASH_EXECUTOR_OUTPUT_BYTES=65536

# Meta Model API: Muse Spark actor + Muse Wonder judge
MODEL_API_KEY=
SPARK_BASE_URL=https://api.meta.ai/v1
SPARK_MODEL=muse-spark-1.3
JUDGE_BASE_URL=https://api.meta.ai/v1
JUDGE_MODEL=muse-wonder-1.0

# Comma-separated hostnames. Localhost is always permitted for safe demo receivers.
LEASH_ALLOWED_HTTP_HOSTS=localhost,127.0.0.1
LEASH_ALLOWED_HTTP_PORTS=8877
LEASH_HTTP_TIMEOUT_SECONDS=5
LEASH_HTTP_REQUEST_BYTES=65536
LEASH_HTTP_RESPONSE_BYTES=65536
LEASH_CAPTURE_HOST=127.0.0.1
LEASH_CAPTURE_PORT=8877
LEASH_CAPTURE_REQUEST_BYTES=65536

